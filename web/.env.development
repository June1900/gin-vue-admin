ENV='development'
VITE_CLI_PORT=8080
VITE_SERVER_PORT=18888
VITE_BASE_API=/api
VITE_FILE_API=/api
VITE_BASE_PATH=http://127.0.0.1
VITE_POSITION=open
VITE_EDITOR=code
#// VITE_EDITOR=webstorm 如果使用webstorm开发且要使用dom定位到代码行功能 请先自定添加 webstorm到环境变量 再将VITE_EDITOR值修改为webstorm
#// 如果使用docker-compose开发模式，设置为下面的地址或本机主机IP
#//VITE_BASE_PATH = http://177.7.0.12

# ----- API 加解密开关 -----
# true: 启用后端 API 加解密(配合 VITE_APP_RSA_PUBLIC_KEY)
# 单个请求是否加密由 service() 调用处的 isEncrypt:true 控制
# 留空/false: 关闭,所有请求按原方式传输
VITE_APP_ENCRYPT=true

# 后端 RSA 公钥(单行 base64,无 PEM 头尾/换行)
# 生成方法: cd server && go run ./cmd/keygen/
# 转换方法: 把 PEM body 行拼接,去掉 -----BEGIN/-----END----- 与所有换行
# rsa.js 兼容完整 PEM 与单行 base64,但 .env 文件不支持多行值,所以推荐单行格式
VITE_APP_RSA_PUBLIC_


